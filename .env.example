# Copy to .env for local uv runs only. Deployment script reads exported variables.
APP_ENV=local
PORT=3978
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-account.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_ENDPOINT=https://your-foundry-account.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT_NAME=your-responses-model-deployment

# Export these for scripts/deploy.sh. No client secret is needed.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=westeurope
# Optional when the Foundry account is in a different subscription.
AZURE_MODEL_SUBSCRIPTION_ID=
PREFIX=teamsdemo
ENVIRONMENT=dev
IMAGE_TAG=
